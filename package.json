{
  "name": "@local-labs-jpollock/local-addon-api",
  "version": "0.0.1",
  "description": "Comprehensive addon development toolkit for Local by Flywheel",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "require": "./lib/core/index.js"
    },
    "./node": {
      "types": "./lib/node/index.d.ts",
      "require": "./lib/node/index.js"
    },
    "./wordpress": {
      "types": "./lib/wordpress/index.d.ts",
      "require": "./lib/wordpress/index.js"
    },
    "./site": {
      "types": "./lib/site/index.d.ts",
      "require": "./lib/site/index.js"
    },
    "./utils": {
      "types": "./lib/utils/index.d.ts",
      "require": "./lib/utils/index.js"
    },
    "./types": {
      "types": "./lib/types/index.d.ts",
      "require": "./lib/types/index.js"
    }
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest tests/unit/utils/validation.test.ts tests/unit/node/GitManager.test.ts tests/unit/wordpress/WpCliManager.test.ts --coverage",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "peerDependencies": {
    "@getflywheel/local": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@getflywheel/local": {
      "optional": true
    }
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "simple-git": "^3.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@getflywheel/local": "^9.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.11",
    "@types/node": "^18.19.0",
    "@types/react": "^19.2.7",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typedoc": "^0.25.0",
    "typedoc-plugin-missing-exports": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "local",
    "wordpress",
    "addon",
    "nodejs",
    "headless",
    "flywheel",
    "wpengine"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpollock/local-addon-api"
  },
  "homepage": "https://github.com/jpollock/local-addon-api#readme",
  "bugs": {
    "url": "https://github.com/jpollock/local-addon-api/issues"
  },
  "author": "Jeremy Pollock",
  "engines": {
    "node": ">=18.0.0"
  }
}
